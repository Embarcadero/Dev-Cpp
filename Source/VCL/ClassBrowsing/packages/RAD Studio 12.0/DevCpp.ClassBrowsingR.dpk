package DevCpp.ClassBrowsingR;

{$R *.res}
{$IFDEF IMPLICITBUILDING This IFDEF should not be used by users}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION OFF}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES ON}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DEFINE DEBUG}
{$ENDIF IMPLICITBUILDING}
{$DESCRIPTION 'Dev-C++ ClassBrowsing components (runtime)'}
{$LIBSUFFIX AUTO}
{$RUNONLY}
{$IMPLICITBUILD OFF}

requires
  rtl,
  vcl;

contains
  CBUtils in '..\..\CBUtils.pas',
  CharUtils in '..\..\CharUtils.pas',
  ClassBrowser in '..\..\ClassBrowser.pas',
  CodeCompletion in '..\..\CodeCompletion.pas',
  CodeCompletionForm in '..\..\CodeCompletionForm.pas' {CodeComplForm},
  CppParser in '..\..\CppParser.pas',
  CppPreprocessor in '..\..\CppPreprocessor.pas',
  CppTokenizer in '..\..\CppTokenizer.pas',
  IntList in '..\..\IntList.pas',
  StatementList in '..\..\StatementList.pas';
end.
